FROM python:3.12-slim
WORKDIR /app
COPY deploy/requirements-speech.txt /tmp/requirements-speech.txt
RUN pip install --no-cache-dir -r /tmp/requirements-speech.txt && useradd --uid 10001 --create-home infinity && mkdir /data && chown infinity:infinity /data
COPY server /app/server
COPY client /app/client
USER infinity
EXPOSE 8787
CMD ["python", "server/app.py", "--host", "0.0.0.0", "--port", "8787", "--data", "/data"]
