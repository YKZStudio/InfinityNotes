FROM node:22-slim AS frontend
WORKDIR /build
COPY package.json package-lock.json ./
COPY tools/prepare.mjs tools/prepare.mjs
COPY third_party third_party
RUN npm ci --omit=dev --ignore-scripts && node tools/prepare.mjs
FROM python:3.12-slim
WORKDIR /app
COPY deploy/requirements-speech.txt /tmp/requirements-speech.txt
RUN pip install --no-cache-dir -r /tmp/requirements-speech.txt && useradd --uid 10001 --create-home infinity && mkdir /data && chown infinity:infinity /data
COPY server /app/server
COPY client /app/client
COPY --from=frontend /build/client/vendor /app/client/vendor
USER infinity
EXPOSE 8787
CMD ["python", "server/app.py", "--host", "0.0.0.0", "--port", "8787", "--data", "/data"]
